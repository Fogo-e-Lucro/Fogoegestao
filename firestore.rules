rules_version = '2';

// Regras do Firestore do Fogo & Gestão (projeto calendario-cd198).
// Publicadas em 01/11/2026 no lugar da regra de abril, que deixava qualquer login,
// até o anônimo, ler e gravar tudo. A versão de setembro deste arquivo nunca foi ao ar.
//
// Quem entra:
// - Equipe: login que não é anônimo e tem doc em app_members (id = btoa(email) com o que
//   não é letra ou número trocado por "_", igual ao checkAccess do app). Lê e grava tudo.
// - Login anônimo: portal do cliente (/cliente/[slug]), só o cadastro pelo slug e os posts.
// - Sem login: só a página de assinatura de contrato (#assinar?id=X).
// VPS, cron da Vercel e MCP usam a service account e não passam por estas regras.
//
// Publicar: securityRules().releaseFirestoreRulesetFromSource() do firebase-admin na VPS.
service cloud.firestore {
  match /databases/{database}/documents {

    function memberId() {
      return request.auth.token.email.toUtf8().toBase64().replace('[^a-zA-Z0-9]', '_');
    }

    function isTeam() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (request.auth.token.email == 'assessoria@fogoelucro.com.br'
          || exists(/databases/$(database)/documents/app_members/$(memberId())));
    }

    function isPortal() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    match /{path=**} {
      allow read, write: if isTeam();
    }

    // Portal: só consulta filtrada por cliente (o app usa where == e limit).
    match /clientes_base/{doc} {
      allow list: if isPortal() && resource.data.slug is string && request.query.limit <= 1;
    }
    match /posts/{doc} {
      allow list: if isPortal() && resource.data.restaurante is string && request.query.limit <= 500;
    }

    // Assinatura pública: lê pelo id e só grava os campos da assinatura,
    // o contador de visitas ou a troca pra "expired".
    match /contratos/{doc} {
      allow get: if true;
      allow update: if
        (resource.data.status == 'pending'
          && request.resource.data.status == 'signed'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'signatureText', 'signCpf', 'signIp', 'signUserAgent', 'selfieDataUrl', 'signedAt'])
          && request.resource.data.signatureText is string
          && request.resource.data.signatureText.size() >= 3
          && request.resource.data.selfieDataUrl is string
          && request.resource.data.selfieDataUrl.matches('data:image/.*'))
        || (resource.data.status in ['pending', 'expired']
          && request.resource.data.status == 'expired'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['viewCount', 'firstViewedAt', 'lastViewedAt']));
    }
  }
}
